# Copy to .env and fill in. .env is gitignored and must never be committed.
# Everything else is configured in the database; see the README.

# --- Required (secret) ---
# Encrypts the secrets stored in the database. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (`boopbox generate-key` does the same once the server package is installed,
# e.g. `docker compose run --rm app boopbox generate-key`.)
# Keep a copy outside the database: without it the stored secrets are lost.
BOOPBOX_SECRET_KEY=
# Alternative: a keyring file, one key per line, first line active.
# BOOPBOX_SECRET_KEYS_FILE=/run/secrets/boopbox-keys

# --- First start only (secret) ---
# Creates the owner account while the database has no users; ignored afterwards.
# Username: 3-32 of a-z 0-9 . _ -   Password: 12-128 characters.
# The password must be changed at first login.
BOOPBOX_DEFAULT_USERNAME=admin
BOOPBOX_DEFAULT_PASSWORD=

# --- Paths (optional) ---
# SQLite file. Keep on a local (non-networked) filesystem; WAL needs local locking.
BOOPBOX_DB_PATH=boopbox.db
# Built OTA bins: <dir>/<chip>/boopbox-<version>.bin. Not the repo's firmware/ dir.
BOOPBOX_FIRMWARE_DIR=firmware-bins

# --- Setting overrides (optional) ---
# Any setting can be pinned here: BOOPBOX_ + key upper-cased, '.' -> '_'.
# An empty value counts as unset, so the database value or default applies.
#
# Bundled broker (docker compose --profile bundled-broker up):
#   BOOPBOX_MQTT_HOST=mosquitto
#   BOOPBOX_MQTT_PORT=1883
#   BOOPBOX_MQTT_USERNAME=boopbox-server
#   BOOPBOX_MQTT_PASSWORD=<the server account password>
BOOPBOX_MQTT_HOST=localhost
BOOPBOX_MQTT_PORT=1884
BOOPBOX_MQTT_USERNAME=
BOOPBOX_MQTT_PASSWORD=
BOOPBOX_PUBLIC_BASE_URL=http://127.0.0.1:9685
# BOOPBOX_OTA_MANIFEST_VERSION=0.3.3

# Host port for the bundled broker (read by docker compose, not the server).
# BOOPBOX_BROKER_HOST_PORT=1884

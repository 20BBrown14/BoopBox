# Secrets and deploy-specific values. Copy to .env and fill in.
# .env is gitignored and must never be committed.

# --- Secret: required ---
# HMAC signing secret for stream tokens.
BOOPBOX_STREAM_SECRET=change-me

# --- User auth (secret) ---
# The UI/API authenticates a user against this single credential and receives a
# short-lived JWT signed with BOOPBOX_JWT_SECRET. Verified on user-facing routes
# (e.g. POST /ota/update). Leave the credential empty to disable login.
BOOPBOX_AUTH_USERNAME=admin
BOOPBOX_AUTH_PASSWORD=change-me
# Must be at least 32 bytes when set (RFC 7518 HS256 minimum); the server
# refuses to start with a shorter secret. Generate e.g. `openssl rand -hex 32`.
BOOPBOX_JWT_SECRET=change-me-to-a-32-byte-or-longer-random-secret
BOOPBOX_JWT_TTL_SECONDS=3600

# --- Config path (optional) ---
# Defaults to ./config.yaml relative to the server working directory.
BOOPBOX_CONFIG_PATH=config.yaml

# --- Database (optional) ---
# SQLite file path. Keep on a local (non-networked) filesystem; WAL needs local locking.
BOOPBOX_DB_PATH=devices.db

# --- OTA firmware bins directory (optional; non-secret, deploy-specific) ---
# Where the admin mounts BUILT .bin files the OTA host serves. This is NOT the
# repo's firmware/ ESPHome-source dir. Layout: <dir>/<chip>/boopbox-<version>.bin
BOOPBOX_FIRMWARE_DIR=firmware-bins

# --- MQTT connection (optional; defaults shown) ---
# Bundled broker (docker compose --profile bundled-broker up): point the app at
# the mosquitto service name and the server account provisioned via
# mosquitto_passwd. Set:
#   BOOPBOX_MQTT_HOST=mosquitto
#   BOOPBOX_MQTT_PORT=1883
#   BOOPBOX_MQTT_USERNAME=boopbox-server
#   BOOPBOX_MQTT_PASSWORD=<the server account password>
# External broker (profile omitted): point BOOPBOX_MQTT_HOST at the admin's
# broker and set its credentials. Defaults below suit a bare local run.
BOOPBOX_MQTT_HOST=localhost
BOOPBOX_MQTT_PORT=1884
BOOPBOX_MQTT_USERNAME=
BOOPBOX_MQTT_PASSWORD=
BOOPBOX_MQTT_TLS=false
BOOPBOX_MQTT_TLS_CA=

# --- Public base URL (optional; default loopback) ---
BOOPBOX_PUBLIC_BASE_URL=http://127.0.0.1:9685

# --- Per-source API keys (secret) ---
# Keyed by source id: BOOPBOX_SOURCE_<ID>_API_KEY, where <ID> is the source id
# uppercased with non-alphanumeric characters replaced by underscores.
# Example for source id "jellyfin-main":
BOOPBOX_SOURCE_JELLYFIN_MAIN_API_KEY=

# --- Seed device (MVP only) ---
# One test device upserted into the devices table at startup.
BOOPBOX_SEED_DEVICE_ID=boop-test
# Secret: provisioned at the broker, not stored in the devices table.
BOOPBOX_SEED_DEVICE_MQTT_PASSWORD=
# Secrets: MVP stand-in for device provisioning. Hashed and stored on the seed
# device row at startup; the plaintext is what the box would be flashed with.
#   - OTA secret: presented as the HTTP Basic password on the firmware bin fetch.
#   - API token:  presented as an Authorization: Bearer token on device API routes.
BOOPBOX_SEED_DEVICE_OTA_SECRET=
BOOPBOX_SEED_DEVICE_API_TOKEN=
